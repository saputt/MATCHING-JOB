// This is your Prisma schema file
// Hyperlocal IT Career Matchmaker - Final Version

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationPreference {
  ALL
  BANDUNG
  REMOTE
}

model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  
  titleInterest String? @map("title_interest")
  skills    String[]  
  
  locationPreference LocationPreference @default(ALL)
  embedding Unsupported("vector(384)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyses  Analysis[]

  @@map("users")
}

model Job {
  id          String   @id @default(uuid())
  title       String?
  company     String?
  description String?   
  url         String 
  location    String?
  city        String?  
  source      String   @default("glints")
  skills      String[] @default([])
  softskills String[] @default([])
  joblevel String? 
  salary String?
  isIt Boolean? @map("is_it")
  is_ok Boolean @default(false)
  scrapedAt   DateTime @default(now()) @map("scraped_at")
  analyses    Analysis[]
  is_active Boolean @default(true)
  embedding Unsupported("vector(384)")?

  @@unique([title, company])
  @@index([city])
  @@map("jobs")
}

model Analysis {
  id        String   @id @default(uuid())
  
  matchScore      Int      @map("match_score")
  matchedSkills   String[] @map("matched_skills")
  missingSkills   String[] @map("missing_skills")
  
  aiNarrative     String   @map("ai_narrative")
  learningRoadmap String[] @map("learning_roadmap")
  proTip          String?  @map("protip")
  
  jobId      String @map("job_id")
  job        Job    @relation(fields: [jobId], references: [id])
  
  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id])
  
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, jobId])
  @@index([matchScore])
  @@map("analyses")
}

model MarketInsight {
  id          String   @id @default(uuid())
  
  insightType String   @map("insight_type")  
  data        Json                         
  
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  
  createdAt   DateTime @default(now())

  @@unique([insightType, periodStart, periodEnd])
  @@map("market_insights")
}

model ScrapingLog {
  id              String   @id @default(uuid())
  status          String   
  source          String   @default("glints")
  
  totalFound      Int      @default(0)
  totalInserted   Int      @default(0)
  totalDuplicated Int      @default(0)
  totalSkipped    Int      @default(0)  
  
  errorMessage    String?  
  
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([status, startedAt])
  @@map("scraping_logs")
}